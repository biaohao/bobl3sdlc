# Finance App Environment Variables
# Copy to .env.local for local development

# Optional: Backend proxy URL if CORS blocks direct Yahoo Finance calls
# VITE_PROXY_URL=https://your-proxy.example.com/api

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=

# Optional: Feature flags
# VITE_ENABLE_CUSTOM_TICKER=true